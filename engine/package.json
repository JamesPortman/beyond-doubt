{
  "name": "@clues/engine",
  "version": "0.1.0",
  "description": "Deterministic no-guess deduction engine. Theme is a skin layer; en/pt/es built in.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --no-warnings --test \"dist-test/test/*.test.js\"",
    "fuzz": "tsc -p tsconfig.test.json && node scripts/fuzz.mjs",
    "demo": "tsc -p tsconfig.demo.json && node scripts/build-demo.mjs",
    "serve": "npm run build && npm run demo && node --no-warnings scripts/serve.mjs",
    "verify": "npm run test && npm run fuzz && npm run e2e",
    "test:pg": "tsc -p tsconfig.test.json && CLUES_PG=\"${DATABASE_URL:-postgres://postgres:devpw@127.0.0.1:5432/clues}\" node --no-warnings --test \"dist-test/test/server*.js\"",
    "typecheck:demo": "tsc -p tsconfig.demo.json",
    "e2e": "npm run build && npm run demo && node --no-warnings scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.28.2",
    "typescript": "5.6"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "pg": "^8.13.0"
  }
}
